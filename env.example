# Phase 2 환경 변수 예시 파일
# 실제 사용 시 .env 파일로 복사하여 사용하세요

# 애플리케이션 설정
APP_NAME=Crypto Trading Subscription Service
VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true

# 서버 설정
HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# 데이터베이스 설정
DATABASE_URL=postgresql://user:password@localhost:5432/crypto_trading
REDIS_URL=redis://localhost:6379

# JWT 설정
SECRET_KEY=your-super-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Stripe 설정 (결제 처리)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# 이메일 설정 (SendGrid)
SENDGRID_API_KEY=SG.your_sendgrid_api_key
FROM_EMAIL=noreply@crypto-trading.com

# SMS 설정 (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Binance API 설정
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
BINANCE_TESTNET=true

# 로깅 설정
LOG_LEVEL=INFO
LOG_FORMAT=json

# 보안 설정
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_PER_MINUTE=60

# 구독 플랜 설정
BASIC_PLAN_PRICE_MONTHLY=29
BASIC_PLAN_PRICE_YEARLY=290
PREMIUM_PLAN_PRICE_MONTHLY=79
PREMIUM_PLAN_PRICE_YEARLY=790
PRO_PLAN_PRICE_MONTHLY=199
PRO_PLAN_PRICE_YEARLY=1990